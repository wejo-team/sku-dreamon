# Local development only. Matches the root compose.yaml PostgreSQL service.
DATABASE_URL=postgresql+asyncpg://wejo:wejo@127.0.0.1:5432/wejo
# Tests only run DB integration checks when this dedicated URL is set.
# TEST_DATABASE_URL=postgresql+asyncpg://wejo:wejo@127.0.0.1:5432/wejo_test
# 인증을 연결할 환경에서 생성한 32바이트 이상의 난수 키를 주입합니다.
# CSRF_SIGNING_KEY=
# 프론트와 API는 같은 HTTPS site에 배치하고 origin은 정확히 지정합니다.
# AUTH_ALLOWED_ORIGINS=["https://localhost:5173"]

# 운영자가 준비한 목록을 지정해야 가입을 허용합니다. 실제 목록은 커밋하지 않습니다.
# PASSWORD_BLOCKLIST_PATH=/path/to/password-blocklist.txt
# PASSWORD_BLOCKLIST_VERSION=2026-10-24
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=100
AUTH_SIGNUP_IP_LIMIT=10
AUTH_AVAILABILITY_IP_LIMIT=100
