# Local development only. Matches the root compose.yaml PostgreSQL service.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://wejo:wejo@127.0.0.1:5432/wejo_dev
# 운영은 APP_ENV=production 및 아래 항목을 모두 명시해야 시작합니다.
# DB URL의 query parameter는 금지하며, TLS 검증은 지정한 CA로 수행합니다.
# DATABASE_TLS_CA_FILE=/run/config/rds-ca-bundle.pem
# HTTP_ALLOWED_HOSTS=["api.example.com"]
# 단일 Nginx의 고정 IP 또는 좁은 전용 네트워크만 신뢰합니다. wildcard 금지.
# HTTP_TRUSTED_PROXIES=["192.0.2.10"]
# 운영 실행: uv run python -m app.cli.serve (Uvicorn 전달 헤더 처리 비활성)
# Nginx는 X-Forwarded-For를 연결 IP 하나로, X-Forwarded-Proto를 https로 덮어씁니다.
# pool은 프로세스당 3+2의 초기 제한이며 운영 DB 수용량 보장은 아닙니다.
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=3
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_COMMAND_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_SECONDS=10
DATABASE_LOCK_TIMEOUT_SECONDS=2
DATABASE_IDLE_TRANSACTION_TIMEOUT_SECONDS=15
READINESS_TIMEOUT_SECONDS=3
SHUTDOWN_TIMEOUT_SECONDS=10
# Tests only run DB integration checks when this dedicated URL is set.
# 별도 compose.test.yaml의 비영구 테스트 DB를 사용합니다.
# TEST_DATABASE_URL=postgresql+asyncpg://wejo:wejo@127.0.0.1:55433/wejo_test
# 인증을 연결할 환경에서 생성한 32바이트 이상의 난수 키를 주입합니다.
# CSRF_SIGNING_KEY=
# 프론트와 API는 같은 HTTPS site에 배치하고 origin은 정확히 지정합니다.
# AUTH_ALLOWED_ORIGINS=["https://localhost:5173"]

# 운영자가 준비한 목록을 지정해야 가입을 허용합니다. 실제 목록은 커밋하지 않습니다.
# PASSWORD_BLOCKLIST_PATH=/path/to/password-blocklist.txt
# PASSWORD_BLOCKLIST_VERSION=2026-10-24
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_IP_LIMIT=100
AUTH_SIGNUP_IP_LIMIT=10
AUTH_AVAILABILITY_IP_LIMIT=100

# AI 서버 전용 설정. 실제 키는 .env에만 입력합니다.
OPENAI_API_KEY=
# AI를 제공하기로 한 배포에서는 true로 하여 키 누락을 시작 실패로 처리합니다.
AI_REQUIRED=false
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=90
AI_CLEANUP_TIMEOUT_SECONDS=5
AI_RETENTION_SECONDS=86400

# 명시적으로 켜면 원문 없이 모델·도구 시간/상태/토큰 사용량만 LangSmith로 보냅니다.
# 요청·계정·세션·팀·지원·대화 ID, 입력·결과·예외 문자열은 전송하지 않습니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sku-dreamon
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 여러 workspace에 접근하는 조직 키를 사용하는 경우 명시합니다.
# LANGSMITH_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
