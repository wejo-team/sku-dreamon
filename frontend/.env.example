# Public browser configuration only. Keep secrets in the backend environment.
VITE_API_BASE_URL=/api/v1
# Used only by the local Vite development server.
API_PROXY_TARGET=http://127.0.0.1:8000
# 화면의 API 요청을 어디로 보낼지 정합니다. 생략하면 개발 서버는 true, 운영 빌드는 false입니다.
#   true  : lib/api-mock 목업 서버가 같은 요청(CSRF 포함)을 받아 목업 데이터로 응답
#   false : 실제 백엔드(/api/v1, 위 API_PROXY_TARGET으로 전달)
VITE_API_MOCK=true
# 실서버 인증 확인용 로컬 HTTPS 인증서(선택). 둘 다 지정하면 https://localhost:5173으로 실행합니다.
# DEV_HTTPS_CERT=./certs/localhost.pem
# DEV_HTTPS_KEY=./certs/localhost-key.pem
